<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_space"
    tools:context=".MainActivity">

    <com.moxin1044.drivemosh.ui.TechBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="18dp">

        <com.moxin1044.drivemosh.ui.TechPanel
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_accent_bar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.22"
                        android:text="@string/label_g_force"
                        android:textColor="@color/neon_cyan"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/label_acceleration"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/liveDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="&#9679;"
                        android:textColor="@color/neon_cyan"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:letterSpacing="0.18"
                        android:text="@string/label_live"
                        android:textColor="@color/neon_cyan"
                        android:textSize="9sp" />
                </LinearLayout>

                <com.moxin1044.drivemosh.ui.GForceView
                    android:id="@+id/gForceView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="@string/label_acceleration"
                    android:focusable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/gValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-thin"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.02"
                            android:shadowColor="#6600E5FF"
                            android:shadowRadius="12"
                            android:text="0.00"
                            android:textColor="@color/text_primary"
                            android:textSize="46sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="7dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/label_unit_g"
                            android:textColor="@color/neon_cyan"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/gAxis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.06"
                        android:text="X +0.00   Y -0.00"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/gPeak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#1000E5FF"
                        android:letterSpacing="0.12"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/label_peak"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </com.moxin1044.drivemosh.ui.TechPanel>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.22">

            <com.moxin1044.drivemosh.ui.ClockView
                android:id="@+id/clockView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/label_drive_mode" />

            <com.moxin1044.drivemosh.ui.SpeedView
                android:id="@+id/speedView"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"
                android:clickable="true"
                android:contentDescription="@string/cd_speed"
                android:focusable="true" />
        </FrameLayout>

        <com.moxin1044.drivemosh.ui.TechPanel
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1.05">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_accent_bar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.18"
                        android:text="@string/label_now_playing"
                        android:textColor="@color/neon_cyan"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/label_playing"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.moxin1044.drivemosh.ui.EqualizerView
                        android:id="@+id/equalizerView"
                        android:layout_width="54dp"
                        android:layout_height="16dp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="6dp">

                    <com.moxin1044.drivemosh.ui.DiscRingView
                        android:id="@+id/discRingView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/albumArt"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_disc_placeholder"
                        android:contentDescription="@string/cd_album_art"
                        android:padding="19dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_music_note"
                        android:tint="@color/neon_cyan"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DriveMosh.Circle"
                        app:strokeColor="#3300E5FF"
                        app:strokeWidth="1dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/trackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="@string/no_track"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/trackArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/no_track_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timePosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="0:00"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="0"
                        android:progressBackgroundTint="#1AFFFFFF"
                        android:progressTint="@color/neon_cyan" />

                    <TextView
                        android:id="@+id/timeDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="--:--"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnPrevious"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="@string/cd_previous"
                        android:padding="12dp"
                        android:src="@drawable/ic_skip_previous"
                        app:tint="@color/text_primary" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginHorizontal="20dp"
                        android:background="@drawable/bg_play_button"
                        android:contentDescription="@string/cd_play"
                        android:padding="15dp"
                        android:src="@drawable/ic_play"
                        app:tint="@color/deep_space" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="@string/cd_next"
                        android:padding="12dp"
                        android:src="@drawable/ic_skip_next"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mediaHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:padding="3dp"
                    android:text="@string/enable_media_access"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.moxin1044.drivemosh.ui.TechPanel>
    </LinearLayout>

</FrameLayout>
